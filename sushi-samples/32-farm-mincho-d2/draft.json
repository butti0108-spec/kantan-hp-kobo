 "fields": {
  "hero_title": "畑の朝を、\nそのまま食卓へ。",
  "headingScale": "1",
  "hero_lead_1": "朝に採った野菜と、畑の小麦で焼くパンを並べる、小さな直売所です。",
  "hero_lead_2": "その日の収穫は、店先の黒板とこのページでお知らせします。",
  "brand_name": "ひだまり農園",
  "value_1_title": "朝採りの野菜",
  "value_1_text": "出すのは、その朝に畑から上がった物だけ。採れなかった日は、棚が空きます。",
  "value_2_title": "畑の小麦のパン",
  "value_2_text": "園内で育てた小麦を、週末だけパンに焼きます。数に限りがあるので午前が確実です。",
  "value_3_title": "量り売りの直売所",
  "value_3_text": "野菜は量り売り。少しだけ欲しい方も、袋なしでそのままどうぞ。",
  "about_section_name": "農園について",
  "about_heading": "土と相談しながら作る",
  "about_name": "ひだまり農園",
  "about_lead": "町の外れの小さな畑で、野菜と小麦を育てています。農薬は使わず、堆肥は近くの牧場から。直売所は畑の脇の小屋で、採れた物をそのまま並べるだけの、素朴な店です。天気の悪い日は、収穫自体が休みになります。",
  "acc_1_title": "直売所の使い方",
  "acc_1_body": "野菜は量り売りで、レジ袋は有料です。パンは土日祝のみ、焼き上がりは10時ごろ。まとまった注文（飲食店様など）は、メールで事前にご相談ください。収穫体験は季節ごとに募集します。",
  "works_section_name": "直売所の品",
  "works_heading": "今日の棚から",
  "works_lead": "季節で中身が変わります。",
  "work_1_title": "季節の野菜セット",
  "work_1_text": "その朝の収穫から5〜6種を詰めた箱。内容は黒板でご案内します。",
  "work_2_title": "畑のパンの日",
  "work_2_text": "土日祝だけ焼く、自家栽培小麦のパン。売り切れ次第、その日は終わりです。",
  "work_3_title": "干し野菜と加工品",
  "work_3_text": "採れすぎた日の野菜を、干したり漬けたり。日持ちする形で棚に並びます。",
  "hours_text": "直売所 9:00–15:00（売り切れ次第閉店）／パンの日は土日祝のみ　月曜・雨天休み",
  "address_text": "架空郡ひだまり町畑野 412　畑の脇の小屋",
  "access_text": "最寄バス停から徒歩8分。駐車場は小屋前に4台分あります。",
  "contact_section_name": "ご連絡",
  "contact_label": "ご連絡",
  "contact_email": "tegami@hidamari-farm.example",
  "contact_note_1": "まとまったご注文や収穫体験のお問い合わせは、メールにてどうぞ。",
  "contact_note_2": "畑仕事の合間の返信になります。2〜3日いただくことがあります。"
 },
